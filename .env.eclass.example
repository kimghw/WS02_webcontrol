# .env.eclass 빈 양식 — 복사해 .env.eclass 로 쓰고 값을 채운다(.env.eclass 는 gitignore).
# probes/ea_eclass_probe.py 와 ea_core 가 읽는다. gate(SSO) ID/PW 는 여기에 두지 않는다 — 로그인은 사용자 직접.

# CDP 채널 포트(spec/spec_아키텍처.md ② 채널 표가 원본). 비우면 9333.
ECLASS_CDP_PORT=9333

# RealEANet(전자결재) 성명 핸드셰이크에 넣을 성명. 비우면 정탐이 needs_name 으로 멈추고 사용자가 직접 입력한다.
KRS_EA_NAME=
